{
  "name": "f125-apex-engineer-telemetry",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first F1 25 telemetry and lap-analysis tool for repeatable setup development.",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "esbuild frontend/circuit-profiler.js --bundle --format=iife --outfile=static/circuit-profiler.bundle.js",
    "check:frontend": "esbuild frontend/circuit-profiler.js --bundle --format=iife --outfile=/tmp/f125-circuit-profiler-check.js",
    "check:python": "python3 -m py_compile src/f1telemetry/*.py utils/*.py",
    "test": "python3 -m unittest discover -s tests -v",
    "check": "npm run check:python && npm run check:frontend && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HrithikDhongadi/f125-apex-engineer-telemetry.git"
  },
  "keywords": [
    "f1-25",
    "telemetry",
    "udp",
    "lap-analysis"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HrithikDhongadi/f125-apex-engineer-telemetry/issues"
  },
  "homepage": "https://github.com/HrithikDhongadi/f125-apex-engineer-telemetry#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "konva": "^10.7.1"
  }
}
